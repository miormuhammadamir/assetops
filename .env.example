DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kuala_Lumpur
# Optional PostgreSQL variables (when POSTGRES_DB is set)
# POSTGRES_DB=assetops
# POSTGRES_USER=assetops
# POSTGRES_PASSWORD=change-this
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# Production: set DEBUG=0, HTTPS, secure secrets and HSTS after verifying HTTPS
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=3600
